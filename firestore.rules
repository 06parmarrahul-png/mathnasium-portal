rules_version = '2';

// Mathnasium Portal — Firestore Security Rules
//
// CURRENT STANCE (single-tenant deployment):
//   Reads: any signed-in user can read any doc. This is intentional — we
//          have one center (Langley) so there's no real multi-tenant
//          isolation to enforce yet, and the strict cross-tenant rules
//          had subtle edge cases that blocked legitimate work.
//   Writes: still gated. Users can only edit their own profile (cannot
//          escalate role/approved/centerIds). Owner-only operations
//          remain owner-only.
//
// WHEN A SECOND CENTER IS ADDED:
//   We tighten reads back. The plumbing for it is all here — every doc
//   carries `centerId`, queries already filter by centerId, AuthContext
//   knows the active center. Re-enabling strict isolation will be a
//   focused project (rewrite the read clauses to require centerId match)
//   rather than a from-scratch redesign.
//
// CRITICAL FIELDS THAT REQUIRE OWNER PRIVILEGE:
//   On user docs, the following fields can ONLY be changed by an owner
//   (or the user themselves keeping the same value):
//     role, approved, centerId, centerIds, guaranteed, centerMemberships
//   This prevents privilege escalation from the dev console.
//
//   `centerMemberships` is the per-centre operational state map (added
//   when role / priority became centre-scoped). A user editing their own
//   profile must not be able to flip their own approval, instructorType,
//   or any other field inside that map — admin / owner / super-admin
//   only.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return profileExists() && profile().role == 'owner';
    }

    function isSuperAdmin() {
      return profileExists() && profile().role == 'super_admin';
    }

    // Administrative Assistant — owner-equivalent for everything except
    // the Owners-only platformChat. Treated like an owner by isOwnerLike()
    // below; the platformChat block uses the strict isOwner() above.
    function isAdminAssistant() {
      return profileExists() && profile().role == 'admin_assistant';
    }

    // Centre Directors and Directors of Education are top-of-org staff
    // with full owner-equivalent access. Rules can match on ANY of:
    //   - profile.role == 'director'  (first-class role — easiest to set)
    //   - profile.instructorType matches a director title
    // We DON'T look at centerConfig.fixedStaff here because that would
    // require an extra get() per evaluation (Firestore limit). Clients
    // set instructorType when saving the profile.
    function isDirector() {
      return profileExists() && (
        profile().role == 'director'
        || profile().instructorType == 'Center Director'
        || profile().instructorType == 'Centre Director'
        || profile().instructorType == 'Dir. of Education'
        || profile().instructorType == 'Director of Education'
      );
    }

    // True for any role that should be treated the same as the centre
    // owner for permission checks (centre config writes, user management,
    // shift management, etc.). NEVER use this for platformChat — that's
    // strictly isOwner() || isSuperAdmin().
    function isOwnerLike() {
      return isOwner() || isAdminAssistant() || isDirector();
    }

    function isAdmin() {
      return profileExists() && profile().role == 'admin';
    }

    // Lead instructors — not a top-level role, but an instructorType
    // value. Granted limited write access to scheduler-operational
    // collections below (assignments, check-ins, walk-ins) so Leads
    // can run the day-of-day Student Scheduler. NOT granted write
    // access to broader admin config / user docs.
    // Lead detection SCOPED TO A CENTRE.
    //
    // There used to be a plain isLead() here reading only the legacy
    // top-level instructorType. It's gone — every caller now passes a
    // centre, and leaving it around just produced an "unused function"
    // warning on every deploy.
    //
    // Why the centre matters: the top-level instructorType is legacy.
    // Since roles went per-centre, the authoritative value lives in
    // centerMemberships[centreId].instructorType — a Lead at Langley who
    // was set up after that migration has NOTHING in the top-level field,
    // so isLead() returns false for them. That was harmless while the
    // centre catchall granted read to every signed-in user; now that
    // Student Scheduler data is gated, it would lock a genuine Lead out
    // of the floor tools. Check both, per centre.
    //
    // .get(key, default) rather than a bare index so a membership row
    // that predates instructorType doesn't error the whole evaluation.
    function isLeadAt(centerId) {
      return profileExists() && (
        profile().instructorType == 'Lead'
        || (
          'centerMemberships' in profile()
          && centerId in profile().centerMemberships
          && profile().centerMemberships[centerId].get('instructorType', '') == 'Lead'
        )
      );
    }

    // Anyone who legitimately runs the floor at this centre: the admin
    // tier plus Lead instructors. Used for Student Scheduler working
    // data (student names, check-ins, walk-ins) — the people who need it
    // to do their job, and nobody else.
    function canRunFloor(centerId) {
      return isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);
    }

    // ─── Centers (top-level identity docs) ─────────────────────────────
    // Public read (needed for signup picker — unauthenticated).
    // Create: super_admin only. Owners CANNOT create new centers — only
    // the platform operator can onboard new locations.
    // Update / delete: owner of THIS center, or super_admin. Admins can't
    // rename a centre, change its billing tier, etc.
    match /centers/{centerId} {
      // The centre identity doc itself. Public read — the signup page
      // shows a centre picker to people who don't have an account yet.
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update, delete: if isOwnerLike() || isSuperAdmin();

      // ═══════════════════════════════════════════════════════════════
      // SUBCOLLECTIONS
      //
      // There used to be a `match /{document=**}` here granting read to
      // every signed-in staff account, with narrower blocks below it for
      // /leads, /inventory and so on, and a comment claiming the narrower
      // block "wins". IT DOES NOT. Firestore rules are ADDITIVE: every
      // matching rule is evaluated and access is granted if ANY of them
      // allows it. A nested rule cannot revoke a grant made by a rule
      // above it. The practical effect was that any signed-in instructor
      // could read /centers/{id}/leads — parent names, emails and phone
      // numbers — despite the owner-only block that looked like it
      // stopped them.
      //
      // So every subcollection is now listed EXPLICITLY, and the only
      // catchall left grants READ to owner-equivalents. Consequences of
      // that design, on purpose:
      //   • A path nobody enumerated is readable by owners and invisible
      //     to everyone else — quiet by default rather than public by
      //     default.
      //   • There is NO catchall write. Every write path is named below.
      //     A new subcollection fails loudly on first write instead of
      //     silently inheriting broad permissions.
      // If you add a subcollection, add its rule here.
      // ═══════════════════════════════════════════════════════════════

      // ─── Centre configuration ───────────────────────────────────────
      // config/main holds operating days, instructional hours, holidays,
      // fixed staff, branding. EVERY signed-in user reads this —
      // AuthContext subscribes to it on login regardless of role — so
      // read must stay open to all staff. Writes are admin-and-above.
      match /config/{docId} {
        allow read:  if isSignedIn();
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin();
      }

      // ─── Student Scheduler working data ─────────────────────────────
      // Student names, session times, check-in state, walk-ins. Read is
      // admin-and-above PLUS Lead instructors, who run the floor and use
      // the Student Scheduler daily. Ordinary instructors have no UI that
      // reads any of this, so restricting it costs them nothing — and
      // these are children's records, which is reason enough not to leave
      // them open to every account at the centre.

      match /schedulerStudents/{studentId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin();
      }

      match /schedulerAliases/{aliasId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin();
      }

      match /schedulerSettings/{docId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin();
      }

      // Walk-in / manual student additions per day. One doc per date,
      // id = YYYY-MM-DD, written when staff add a call-in via the
      // +student button on a slot.
      match /scheduleAddOns/{dateId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);
      }

      // Per-day instructor assignments (slot -> staff names). Leads staff
      // the floor minute by minute, so they write here.
      match /schedulerInstructorAssignments/{dateId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);
      }

      // Per-day check-ins (student presence / tags / desks), plus the
      // per-student docs underneath. Leads mark students in / late /
      // no-show as they arrive.
      match /schedulerCheckIns/{dateId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);

        match /students/{studentId} {
          allow read:  if canRunFloor(centerId);
          allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);
        }
      }

      // Walk-ins recorded against a date, and the entries underneath.
      match /walkIns/{dateId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);

        match /entries/{entryId} {
          allow read:  if canRunFloor(centerId);
          allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);
        }
      }

      // ─── Analytics snapshots ────────────────────────────────────────
      // Counts and ratios, no PII — but they are management numbers, so
      // they stay on the admin side rather than being centre-wide.
      match /scheduleSnapshots/{snapshotId} {
        allow read:  if canRunFloor(centerId);
        allow write: if isOwnerLike() || isSuperAdmin() || isAdmin() || isLeadAt(centerId);
      }

      // Saved demand + supply overrides per day. Feeds the auto-
      // scheduler's staffing recommendations, so writes stay owner-like.
      match /demandSnapshots/{dateId} {
        allow read:  if isOwnerLike() || isSuperAdmin() || isAdmin();
        allow write: if isOwnerLike() || isSuperAdmin();
      }

      // ─── Leads (the CRM funnel) ─────────────────────────────────────
      // Parent contact info: name, email, phone. Owner-equivalent only —
      // this is the collection the old catchall was quietly exposing.
      // Server-side intake mirroring writes via firebase-admin and
      // bypasses rules entirely, so the auto-create flow is unaffected.
      match /leads/{leadId} {
        allow read, write: if isOwnerLike() || isSuperAdmin();
      }

      // ─── Connectors ─────────────────────────────────────────────────
      // Per-vendor integration state: { connected, requested, settings }.
      // Actual API credentials live in the top-level centerIntegrations
      // collection, not here. Read/write is admin-and-above because the
      // Apptoto appointments card renders inside the Admin Panel.
      match /connectors/{connectorId} {
        allow read, write: if isOwnerLike() || isSuperAdmin() || isAdmin();
      }

      // ─── Inventory (centre supplies) ────────────────────────────────
      // Supply counts, unit costs and vendor links. Admin-and-above.
      // The alert-settings doc (id '__settings') lives in this same
      // collection deliberately, so it inherits this exact rule.
      match /inventory/{itemId} {
        allow read, write: if isOwnerLike() || isSuperAdmin() || isAdmin();
      }

      // ─── Inventory change log ───────────────────────────────────────
      // Append-only: admins add entries (every count change writes one)
      // and read the history, but cannot rewrite or delete it. Only the
      // platform operator can prune. This guarantee only holds because
      // the catchall below grants READ and nothing else — a catchall
      // `write` would have handed every owner a delete button here.
      match /inventoryLog/{entryId} {
        allow read:   if isOwnerLike() || isSuperAdmin() || isAdmin();
        allow create: if isOwnerLike() || isSuperAdmin() || isAdmin();
        allow update, delete: if isSuperAdmin();
      }

      // ─── Catchall: read-only, owner-equivalent ──────────────────────
      // The safety net for any subcollection not named above. Read so a
      // missed path degrades to "only owners can see it" rather than
      // "everyone can". No write, so a missed path fails loudly on the
      // first attempt and gets a proper rule instead of inheriting one.
      match /{document=**} {
        allow read: if isOwnerLike() || isSuperAdmin();
      }
    }

    // ─── Centre intakes (native booking flow) ──────────────────────────
    // Parent-submitted intake bookings — contain PII (email, phone, child
    // name, grade). Created server-side via /api/intakes/create with no
    // auth (parents don't have accounts). Stored as a TOP-LEVEL collection
    // (rather than under /centers/{id}/intakes) deliberately, so the
    // recursive {document=**} grant for signed-in users doesn't expose
    // parent contact info to every staff account. Each doc carries a
    // `centerId` field for filtering.
    match /centerIntakes/{intakeId} {
      allow read, write: if isOwnerLike() || isSuperAdmin();
    }

    // ─── Centre integrations (secrets) ─────────────────────────────────
    // Top-level collection deliberately OUTSIDE /centers/{centerId}/* so
    // it isn't caught by the recursive {document=**} grant above, which
    // would let any signed-in user read the API keys.
    //
    // Doc ID convention: `${centerId}__${vendorId}` — e.g.
    //   centerIntegrations/langley__apptoto
    //
    // The Apptoto / Acuity / future-vendor API keys live here. Server
    // routes (firebase-admin) bypass these rules entirely; the client only
    // needs to write + read the "metadata" fields (email, configuredAt) to
    // know whether the integration is configured.
    match /centerIntegrations/{integrationKey} {
      allow read, write: if isOwnerLike() || isSuperAdmin();
    }

    // ─── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // ─── Private contact sub-collection ──────────────────────────────
      // Sensitive PII (email, phone) lives here, NOT on the parent user
      // doc, so the more-specific rule below restricts reads. The user
      // doc itself stays signed-in-readable so scheduler / chat / shift
      // board continue to render names, photos, roles. Source of truth
      // for email & phone is `users/{uid}/private/contact`. When a user
      // opts to share email/phone publicly, those values are mirrored to
      // `users/{uid}.publicEmail` / `publicPhone` (any signed-in user
      // can read those).
      //
      // Access to the private doc: the user themselves, plus all four
      // management roles. Plain instructors don't see contact info
      // unless the target user mirrored it publicly.
      match /private/{document=**} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == userId
          || isOwnerLike() || isSuperAdmin() || isAdmin()
        );
      }

      // Read: any signed-in user can read any user doc.
      allow read: if isSignedIn();

      // Create only your own profile (signup flow writes /users/{auth.uid}).
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Update:
      //   - Owner / super-admin can update any user.
      //   - Admin can update operational fields (approve, instructorType,
      //     subRoles, priority, etc.) but cannot change a user's `role`,
      //     `centerId`, or `centerIds`, and cannot touch an owner /
      //     super-admin doc at all (no privilege escalation).
      //   - Each user can update their own profile EXCEPT privilege fields
      //     (role, approved, centerId, centerIds, guaranteed stay locked).
      allow update: if isSignedIn() && (
        isOwnerLike() ||
        isSuperAdmin() ||
        (isAdmin()
         && resource.data.role != 'owner'
         && resource.data.role != 'super_admin'
         && resource.data.role != 'admin_assistant'
         && request.resource.data.role      == resource.data.role
         && request.resource.data.centerId  == resource.data.centerId
         && request.resource.data.centerIds == resource.data.centerIds) ||
        (request.auth.uid == userId
         && request.resource.data.role         == resource.data.role
         && request.resource.data.approved     == resource.data.approved
         && request.resource.data.centerId     == resource.data.centerId
         && request.resource.data.centerIds    == resource.data.centerIds
         && (!('guaranteed' in request.resource.data) ||
              request.resource.data.guaranteed  == resource.data.guaranteed)
         // Lock per-centre membership state — a user must not be able
         // to self-approve, give themselves priority 1, or flip
         // instructorType in their own membership map. Uses get() so
         // the comparison works whether or not the field is set.
         && request.resource.data.get('centerMemberships', null)
            == resource.data.get('centerMemberships', null))
      );

      // Delete: owner / super-admin freely. Admins can delete non-elevated
      // users (instructors / hosts / other admins), never owners or
      // super-admins.
      allow delete: if isOwnerLike() || isSuperAdmin() ||
        (isAdmin()
         && resource.data.role != 'owner'
         && resource.data.role != 'super_admin'
         && resource.data.role != 'admin_assistant');
    }

    // ─── Per-tenant collections ────────────────────────────────────────
    // Reads: any signed-in user (single-tenant for now).
    // Writes: gated to keep user actions limited to their own data
    // (creating their own availability, accepting an open shift, etc.)
    // and admin actions limited to owner.

    match /shifts/{shiftId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      // Admins can delete shifts too — they manage the schedule day-to-day.
      allow delete: if isOwnerLike() || isSuperAdmin() || isAdmin();
    }

    // ── Availability change log ──────────────────────────────────────
    // Immutable record of every add / change / removal of availability,
    // so "my availability wasn't in, why am I scheduled?" has an answer.
    //
    // TOP-LEVEL, not under /centers/{id}/…, deliberately — same reason
    // centerIntakes is. The recursive `match /{document=**}` inside
    // /centers/{centerId} grants read to every signed-in staff account,
    // and Firestore rules are ADDITIVE: a narrower rule nested under it
    // CANNOT take that grant back. Only at the root does an admin-only
    // read rule actually hold. Each doc carries `centerId` for filtering.
    //
    // Create is open to any signed-in user because the INSTRUCTOR's own
    // browser writes the row when they edit their availability — but the
    // actorUid must be themselves, so nobody can forge an entry naming
    // someone else as the person who made the change.
    //
    // Update and delete are denied to everyone except the platform
    // operator. A history that can be quietly revised is not a history.
    match /availabilityLog/{entryId} {
      allow read:   if isOwnerLike() || isSuperAdmin() || isAdmin();
      allow create: if isSignedIn()
                       && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /availability/{availId} {
      allow read: if isSignedIn();
      // Create: must be your own doc.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Update / delete: yours, or owner.
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isOwnerLike() || isSuperAdmin()
      );
    }

    match /openShifts/{openShiftId} {
      allow read:   if isSignedIn();
      // Admins create + delete open shifts too — same surface they see in
      // the Scheduler tab.
      allow create: if isOwnerLike() || isSuperAdmin() || isAdmin();
      // Update needed for claim flow — any signed-in user can mark
      // an open shift as claimed via transaction.
      allow update: if isSignedIn();
      allow delete: if isOwnerLike() || isSuperAdmin() || isAdmin();
    }

    match /timeOffRequests/{reqId} {
      allow read: if isSignedIn();
      // Create: must be your own.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Update: managers (admin / owner / super-admin) can approve, deny or
      // amend anything. The instructor who owns the request may edit it ONLY
      // while it is still pending, and may not change its status (no
      // self-approving, and once approved/denied it is locked).
      allow update: if isSignedIn() && (
        isOwnerLike() || isSuperAdmin() || isAdmin() || (
          resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.userId == request.auth.uid
        )
      );
      // Delete: the owner can withdraw their request; managers can remove any.
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isOwnerLike() || isSuperAdmin() || isAdmin()
      );
    }

    match /chat/{msgId} {
      allow read:   if isSignedIn();
      // Create / update: any signed-in user (chat + swap acceptance).
      allow create, update: if isSignedIn();
      // Delete: owner / super-admin can delete anything. Admins can delete
      // shift-swap entries from the Shift Board so they can manage swap
      // requests without going through an owner — but they CANNOT delete
      // general team-chat messages (preserving chat as an audit-able log).
      allow delete: if isOwnerLike() || isSuperAdmin()
                       || (isAdmin() && resource.data.type == 'shift_swap');
    }

    // Owners Chat — cross-centre peer space for owners and Enterprise
    // only. Admins were dropped when Leadership Chat split into two
    // scopes; admins use the per-centre centerLeadership channel below
    // for everything they used to use this for.
    match /platformChat/{msgId} {
      allow read:   if isSignedIn() && (isOwner() || isSuperAdmin());
      allow create: if isSignedIn() && (isOwner() || isSuperAdmin())
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner() || isSuperAdmin());
      allow delete: if isOwner() || isSuperAdmin();
    }

    // Centre Leadership Chat — per-centre management space for admin,
    // owner, AA, and Enterprise. Each message carries a centerId; reads are
    // role-gated here but the client also filters by activeCenterId.
    match /centerLeadership/{msgId} {
      allow read:   if isSignedIn() && (isAdmin() || isOwnerLike() || isSuperAdmin());
      allow create: if isSignedIn() && (isAdmin() || isOwnerLike() || isSuperAdmin())
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isOwnerLike() || isSuperAdmin());
      allow delete: if isOwnerLike() || isSuperAdmin();
    }

    match /announcements/{annId} {
      allow read:  if isSignedIn();
      // Admin-panel writes — admins / owners / super-admins all post and
      // manage announcements. Instructors / hosts can only read.
      allow create, update, delete: if isOwnerLike() || isSuperAdmin() || isAdmin();
    }

    match /notificationPreferences/{userId} {
      // Self-only access for personal preferences.
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Platform meta ────────────────────────────────────────────────
    // Single doc at /platform/meta holding cross-centre settings — most
    // notably the SHA-256 hash of the 4-digit owner-promotion code used
    // by the Manage Roles screen. Plain text never lives in Firestore.
    //
    // Read + write: Enterprise only. The code gate is a coordination
    // guardrail, not real security — Firestore rules still independently
    // enforce that only Enterprise users can change the `role` field on
    // user docs, so even if the hash leaked nothing escalates.
    match /platform/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Connectors, as a COLLECTION GROUP ────────────────────────────
    // The Enterprise demand leaderboard on /connectors runs
    // collectionGroup(db, 'connectors') to count which integrations
    // centres have requested. Collection-group queries are NOT covered
    // by a nested `match /centers/{id}/connectors/...` rule — they need
    // a rule anchored with {path=**}, which didn't exist, so that panel
    // has been failing its read since it shipped. Super-admin only:
    // it's a cross-tenant aggregate and nobody else should run it.
    match /{path=**}/connectors/{connectorId} {
      allow read: if isSuperAdmin();
    }

    // Exception to the Enterprise-only block above: the cross-centre
    // notification switches are READABLE by any signed-in user, because
    // the Inventory page needs to tell an admin "Enterprise has these
    // turned off" rather than silently never sending. Firestore allow
    // rules are additive (any matching rule granting access is enough),
    // so this widens read on this one doc while writes stay Enterprise
    // only — nobody but a super-admin can flip the switch.
    match /platform/notificationSettings {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Audit log ────────────────────────────────────────────────────
    // Append-only record of sensitive platform-operator actions. The
    // value of this collection comes from the fact that entries cannot
    // be revised after the fact — that's why update/delete are flat
    // denied here for every role, including super-admins.
    //
    // Reads are limited to super-admins. (We may relax to "owners can
    // read entries that touched their own centre" in a future pass; for
    // now, super-admins viewing in the Super Admin dashboard is the
    // single read path.)
    //
    // Writes are limited to authenticated users writing as themselves
    // (request.resource.data.actorUid == request.auth.uid), which is
    // what the client-side `logAuditEvent` helper does. This stops a
    // malicious client from forging an entry that names someone else
    // as the actor.
    match /auditLog/{entryId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn()
                       && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Owner Assistant ──────────────────────────────────────────────
    // Per-owner chatbot scratchpad: long-term memory summary at the
    // root doc, message log + events in subcollections. Every doc is
    // strictly siloed to the owner identified in the path. Nobody else
    // — not other owners, not admins, not super-admins — can read or
    // write another owner's assistant data from the client. The
    // server-side handler uses the Admin SDK and bypasses these rules,
    // so it still has full access for the API route.
    match /ownerAssistant/{uid} {
      allow read, write: if isSignedIn()
                            && request.auth.uid == uid
                            && isOwnerLike();
      match /{sub=**} {
        allow read, write: if isSignedIn()
                              && request.auth.uid == uid
                              && isOwnerLike();
      }
    }
  }
}
